{# On étend de base.html.twig #}
{% extends 'base.html.twig' %}

{# on va hériter du title depuis base (Exemple Backend | ) 
et y rajouter le titre de la page actuelle grâce à parent {{ parent() }}  #}
{% block title %}{{ parent() }}Homepage{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    {# affichage d'une variable passée en tableau à la vue twig 
    {{ variable }} => echo $variable
    <?=$name ?> => ne fonctionne pas par défaut
    #}
    <h1>Salut {{ my_name}}, <small>vous êtes sur {{ controller_name }}! ✅</small></h1>
    <navbar>
    <ul>
        <li>Accueil</li>
        <li><a href='{{ path('public_contact') }}'>Contact</a>-> Exemple avec Response</li>
        <li><a href='{{ path('public_article', {'id':5}) }}'>Article 5</a>-> sans protection</li>
    </ul>
    </navbar>
    <h2>Tentative XSS</h2>
    <p>Symfony protège les variables twig par défaut, sinon il faut rajouter<br> XSS|escape ou XSS|e</p>
    <p>{{ XSS }}</p>
    <h2>Script autorisé</h2>
    <p>Pour autoriser un script, il faut utiliser:<br>
    Variable|raw</p>
    <h3>Non interprété</h3>
    <p>{{ my_script }}</p>
    <h3>Interprété avec |raw</h3>
    <p>{{ my_script|raw }}</p>
    
</div>
{% endblock %}
